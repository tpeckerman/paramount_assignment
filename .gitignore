# The fetched source documents ARE committed. A reviewer should be able to clone
# this repo and have the actual regulatory texts, and committing them is what
# makes the quote-integrity check (verify_rules.py --with-quotes) runnable in CI
# rather than permanently skipped. originals.lock.json records the sha256 and
# retrieval date of each, so a committed copy is still provably the published one.
# Run: python pipeline/fetch_originals.py

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Spreadsheet lock files
~$*.xlsx
.~lock.*

# OS
.DS_Store
Thumbs.db
